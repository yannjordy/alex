# Alex Fleet — configuration (NE JAMAIS committer le vrai .env)
# Copier vers .env et remplir. Sans ces variables, Fleet tourne en mode
# « non configuré » : /fleet/state.configured=false, aucun crash.

# URL du projet Supabase (transport non fiable — la sécurité est dans les
# signatures Ed25519 locales, pas dans cette base)
ALEX_SUPABASE_URL=https://votre-projet.supabase.co

# Clé service role (server side) — secrète, jamais dans le repo
ALEX_SUPABASE_KEY=eyJ...

# Rôle de CETTE instance : "mother" (administratrice, contrôle la flotte)
# ou "daughter" (fille, se jumelle et peut être suspendue / se dissocier)
ALEX_FLEET_ROLE=daughter
